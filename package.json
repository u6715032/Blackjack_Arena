{
  "name": "blackjack-arena",
  "version": "1.0.0",
  "private": true,
  "workspaces": ["backend", "frontend"],
  "scripts": {
    "dev": "concurrently -k -n server,web \"npm run dev -w backend\" \"npm run dev -w frontend\"",
    "test": "npm test -w backend",
    "test:ai": "ai-service/.venv/bin/python -m pytest ai-service/tests -q",
    "test:database": "npm run test:database -w backend",
    "build": "npm run build -w frontend"
  },
  "devDependencies": {"concurrently": "^9.2.1"},
  "engines": {"node": ">=22.12"}
}
